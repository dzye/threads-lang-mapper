{
  "manifest_version": 3,
  "name": "Threads 中文阅读",
  "version": "0.1.2",
  "description": "自动将 Threads 帖文与回复转换为简体中文，支持配置目标语言及查看原文。",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Threads 中文阅读",
    "default_icon": {
      "16": "assets/brand/icon-16.png",
      "32": "assets/brand/icon-32.png",
      "48": "assets/brand/icon-48.png",
      "128": "assets/brand/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.com/*",
        "https://threads.com/*",
        "https://www.threads.net/*",
        "https://threads.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/brand/icon-16.png",
    "32": "assets/brand/icon-32.png",
    "48": "assets/brand/icon-48.png",
    "128": "assets/brand/icon-128.png"
  },
  "homepage_url": "https://github.com/dzye/threads-lang-mapper"
}
